# ============================================================
# Mifos / Fineract — LOCAL stack configuration (TEMPLATE)
# ============================================================
# 1. Copy this file to ".env"            (scripts/local-up.sh does it for you)
# 2. Replace every CHANGE_ME_LOCAL value (scripts/local-up.sh auto-generates them)
# 3. NEVER commit your real ".env" — it is git-ignored.
#
# These are LOCAL development passwords only. They are NOT the production
# secrets (production secrets were never exported into this repo).
# ============================================================

# --- PostgreSQL superuser ---
POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE_ME_LOCAL

# --- Fineract application DB user (Fineract connects as this user) ---
FINERACT_DB_USER=postgres
FINERACT_DB_PASS=CHANGE_ME_LOCAL

# --- Fineract master password (encrypts tenant DB credentials) ---
FINERACT_MASTER_PASSWORD=CHANGE_ME_LOCAL

# --- Database names (created automatically on first start) ---
FINERACT_TENANTS_DB_NAME=fineract_tenants
FINERACT_TENANT_DEFAULT_DB_NAME=fineract_default

# --- Local published HTTP port (frontend + API are both served here via nginx) ---
LOCAL_HTTP_PORT=8080

# --- Base URL the BROWSER uses to reach the backend API (through nginx). ---
#     Keep it as localhost for local development. Must match LOCAL_HTTP_PORT.
FINERACT_API_BASE=http://localhost:8080
